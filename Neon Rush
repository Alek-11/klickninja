<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neon Run</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; min-height: 100vh; overflow: hidden;
  }
  canvas {
    display: block; border-radius: 16px; cursor: pointer;
    box-shadow: 0 0 60px rgba(180,60,255,0.4), 0 0 120px rgba(0,200,255,0.15);
    max-width: 100vw; max-height: 90vh;
  }
  #controls { display: none; gap: 12px; margin-top: 14px; flex-wrap: wrap; justify-content: center; }
  #controls button {
    width: 58px; height: 58px; border-radius: 12px;
    background: rgba(180,60,255,0.2); border: 2px solid rgba(180,60,255,0.5);
    color: #fff; font-size: 22px; cursor: pointer; touch-action: none; user-select: none;
  }
</style>
</head>
<body>
<canvas id="c" width="480" height="700"></canvas>
<div id="controls">
  <button id="bl">◀</button><button id="bu">▲</button>
  <button id="bd">▼</button><button id="br">▶</button>
</div>
<script>
const W=480,H=700,GY=560,LX=[100,240,380],LW=120;
const PW=40,PH=60,OW=44,OH=50,CR=12,JF=-18,GV=0.7,SD=60,IS=5,SI=0.001;
const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),ctrlDiv=document.getElementById('controls');
let state='idle',player,obstacles,coins,particles,score,coinCount,speed,frame,bgOff,bgOff2,obTimer,coTimer,nextOb,nextCo,shakeX,shakeY;
function lerp(a,b,t){return a+(b-a)*t;}
function initGame(){
  player={lane:1,x:LX[1],y:GY-PH,vy:0,onGround:true,jumping:false,sliding:false,slideTimer:0,targetX:LX[1],roll:0};
  obstacles=[];coins=[];particles=[];score=0;coinCount=0;speed=IS;frame=0;
  bgOff=0;bgOff2=0;obTimer=0;coTimer=0;nextOb=80;nextCo=60;shakeX=0;shakeY=0;
  state='playing';ctrlDiv.style.display='flex';
}
function spawnObstacle(){
  const count=Math.random()<0.25?2:1,lanes=[];
  while(lanes.length<count){const l=Math.floor(Math.random()*3);if(!lanes.includes(l))lanes.push(l);}
  lanes.forEach(lane=>obstacles.push({lane,x:LX[lane],y:-OH-10,type:Math.random()<0.4?'train':'barrier'}));
  nextOb=Math.max(40,60+Math.floor(Math.random()*80)-Math.min(30,frame/200));obTimer=0;
}
function spawnCoins(){
  const lane=Math.floor(Math.random()*3),count=3+Math.floor(Math.random()*4);
  for(let i=0;i<count;i++)coins.push({lane,x:LX[lane],y:-i*50-30,collected:false});
  coTimer=0;nextCo=50+Math.floor(Math.random()*100);
}
function spawnParticles(x,y,color){
  for(let i=0;i<8;i++)particles.push({x,y,vx:(Math.random()-.5)*5,vy:-Math.random()*5-2,alpha:1,color,r:3+Math.random()*4});
}
function input(action){
  const p=player;if(!p||state!=='playing')return;
  if(action==='left'&&p.lane>0){p.lane--;p.targetX=LX[p.lane];}
  else if(action==='right'&&p.lane<2){p.lane++;p.targetX=LX[p.lane];}
  else if(action==='jump'&&p.onGround){p.vy=JF;p.onGround=false;p.jumping=true;p.sliding=false;p.slideTimer=0;}
  else if(action==='slide'&&p.onGround&&!p.sliding){p.sliding=true;p.slideTimer=SD;}
}
document.addEventListener('keydown',e=>{
  if(state!=='playing'){if(e.key===' '||e.key==='Enter')initGame();return;}
  if(e.key==='ArrowLeft')input('left');else if(e.key==='ArrowRight')input('right');
  else if(e.key==='ArrowUp'||e.key===' ')input('jump');else if(e.key==='ArrowDown')input('slide');
  if([' ','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key))e.preventDefault();
});
let tx=0,ty=0;
canvas.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY;},{passive:true});
canvas.addEventListener('touchend',e=>{
  if(state!=='playing'){initGame();return;}
  const dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;
  if(Math.abs(dx)>Math.abs(dy)){dx>30?input('right'):input('left');}else{dy<-30?input('jump'):input('slide');}
});
canvas.addEventListener('click',()=>{if(state!=='playing')initGame();});
document.getElementById('bl').addEventListener('pointerdown',e=>{e.preventDefault();input('left');});
document.getElementById('br').addEventListener('pointerdown',e=>{e.preventDefault();input('right');});
document.getElementById('bu').addEventListener('pointerdown',e=>{e.preventDefault();input('jump');});
document.getElementById('bd').addEventListener('pointerdown',e=>{e.preventDefault();input('slide');});
function drawBg(){
  const sky=ctx.createLinearGradient(0,0,0,H*.55);
  sky.addColorStop(0,'#0f0c29');sky.addColorStop(.5,'#302b63');sky.addColorStop(1,'#24243e');
  ctx.fillStyle=sky;ctx.fillRect(0,0,W,H*.55);
  ctx.fillStyle='rgba(255,255,255,0.6)';
  [[40,20],[120,45],[200,15],[300,35],[400,10],[460,55],[80,80],[160,60],[250,90],[350,70],[430,85],[60,120]].forEach(([sx,sy])=>{ctx.beginPath();ctx.arc(sx,sy,1,0,Math.PI*2);ctx.fill();});
  const bF=[[0,200,60,160],[55,220,50,140],[100,190,70,170],[165,210,55,150],[215,180,80,180],[290,200,60,160],[345,215,50,145],[390,185,75,175],[460,205,60,155]];
  const fO=(bgOff2*.3)%160;ctx.save();ctx.translate(-fO,0);
  bF.forEach(([bx,by,bw,bh])=>{ctx.fillStyle='rgba(12,8,28,0.98)';[0,160,320].forEach(s=>ctx.fillRect(bx+s,by,bw,bh));});
  ctx.restore();
  [{x:10,y:240,w:80,h:320,c:'#6a0080'},{x:90,y:260,w:60,h:300,c:'#004d5a'},{x:340,y:235,w:90,h:325,c:'#7a0030'},{x:420,y:255,w:65,h:305,c:'#004d5a'}].forEach(b=>{
    const nO=(bgOff2*.6)%200;ctx.save();ctx.translate(-nO,0);
    [-200,0,200,400].forEach(s=>{ctx.fillStyle='rgba(6,3,18,1)';ctx.fillRect(b.x+s,b.y,b.w,b.h);ctx.strokeStyle=b.c;ctx.lineWidth=1;ctx.globalAlpha=.25;ctx.strokeRect(b.x+s,b.y,b.w,b.h);ctx.globalAlpha=1;});
    ctx.restore();
  });
  const rg=ctx.createLinearGradient(0,GY-10,0,H);rg.addColorStop(0,'#1a0533');rg.addColorStop(.3,'#0d0220');rg.addColorStop(1,'#080015');
  ctx.fillStyle=rg;ctx.fillRect(0,GY-10,W,H-GY+10);
  const lO=bgOff%70;[LX[0]+LW/2,LX[1]+LW/2].forEach(lx=>{ctx.strokeStyle='rgba(100,50,180,0.2)';ctx.lineWidth=1.5;ctx.setLineDash([40,30]);ctx.lineDashOffset=-lO;ctx.beginPath();ctx.moveTo(lx,GY);ctx.lineTo(lx,H);ctx.stroke();});
  ctx.setLineDash([]);
}
function drawPlayer(p){
  const ph=p.sliding?PH*.5:PH,py=p.sliding?p.y+PH*.5:p.y;
  ctx.save();ctx.translate(p.x,py+ph/2);if(p.jumping)ctx.rotate(p.roll);
  ctx.fillStyle='rgba(180,60,255,0.3)';ctx.beginPath();ctx.ellipse(0,ph/2+2,PW*.6,6,0,0,Math.PI*2);ctx.fill();
  ctx.shadowColor='#00e5ff';ctx.shadowBlur=20;
  const bg=ctx.createLinearGradient(-PW/2,-ph/2,PW/2,ph/2);bg.addColorStop(0,'#00b4d8');bg.addColorStop(.5,'#0077b6');bg.addColorStop(1,'#03045e');
  ctx.fillStyle=bg;ctx.beginPath();ctx.roundRect(-PW/2,-ph/2,PW,ph,8);ctx.fill();
  if(!p.sliding){ctx.fillStyle='rgba(0,229,255,0.9)';ctx.shadowBlur=15;ctx.beginPath();ctx.roundRect(-PW/2+4,-ph/2+4,PW-8,ph*.25,4);ctx.fill();ctx.fillStyle='#fff';ctx.shadowBlur=10;ctx.beginPath();ctx.ellipse(-6,-ph/2+12,4,3,0,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.ellipse(6,-ph/2+12,4,3,0,0,Math.PI*2);ctx.fill();}
  ctx.fillStyle='#023e8a';ctx.fillRect(PW/2-2,-ph/2+8,10,ph*.5);ctx.shadowBlur=0;ctx.restore();
}
function drawObstacle(o){
  ctx.save();ctx.translate(o.x,o.y);
  if(o.type==='train'){
    ctx.shadowColor='#ff4081';ctx.shadowBlur=20;const tg=ctx.createLinearGradient(-OW/2,0,OW/2,OH);tg.addColorStop(0,'#c62828');tg.addColorStop(.5,'#e53935');tg.addColorStop(1,'#7f0000');
    ctx.fillStyle=tg;ctx.beginPath();ctx.roundRect(-OW/2,0,OW,OH,6);ctx.fill();
    ctx.fillStyle='rgba(255,200,100,0.8)';ctx.fillRect(-OW/2+6,10,10,12);ctx.fillRect(OW/2-16,10,10,12);ctx.fillStyle='#ffeb3b';ctx.fillRect(-OW/2,OH-8,OW,4);
  }else{
    ctx.shadowColor='#ff6d00';ctx.shadowBlur=16;const bg=ctx.createLinearGradient(0,0,0,OH);bg.addColorStop(0,'#bf360c');bg.addColorStop(.5,'#e64a19');bg.addColorStop(1,'#7f2800');
    ctx.fillStyle=bg;ctx.beginPath();ctx.roundRect(-OW/2,OH*.3,OW,OH*.7,4);ctx.fill();ctx.fillStyle='#e64a19';ctx.fillRect(-4,0,8,OH*.35);
    ctx.strokeStyle='#ffcc02';ctx.lineWidth=4;ctx.shadowColor='#ffcc02';ctx.shadowBlur=8;
    for(let i=0;i<3;i++){ctx.beginPath();ctx.moveTo(-OW/2+6,OH*.4+i*12);ctx.lineTo(0,OH*.4+i*12+8);ctx.lineTo(OW/2-6,OH*.4+i*12);ctx.stroke();}
  }
  ctx.shadowBlur=0;ctx.restore();
}
function drawCoin(c){
  if(c.collected)return;ctx.save();ctx.translate(c.x,c.y+Math.sin(frame*.1+c.x)*3);
  ctx.shadowColor='#ffd700';ctx.shadowBlur=16;const cg=ctx.createRadialGradient(-3,-3,2,0,0,CR);cg.addColorStop(0,'#fff176');cg.addColorStop(.4,'#ffd700');cg.addColorStop(1,'#ff6f00');
  ctx.fillStyle=cg;ctx.beginPath();ctx.arc(0,0,CR,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#ff6f00';ctx.font='bold 13px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('$',0,1);ctx.shadowBlur=0;ctx.restore();
}
function checkHit(p,o){
  if(p.lane!==o.lane)return false;const ph=p.sliding?PH*.5:PH,py=p.sliding?p.y+PH*.5:p.y,m=10;
  return p.x-PW/2+m<o.x+OW/2-m&&p.x+PW/2-m>o.x-OW/2+m&&py<o.y+OH-m&&py+ph>o.y+m;
}
function drawIdle(){
  ctx.save();ctx.fillStyle='rgba(5,0,20,0.75)';ctx.fillRect(0,0,W,H);
  ctx.shadowColor='#e040fb';ctx.shadowBlur=30;ctx.fillStyle='#fff';ctx.font='bold 48px sans-serif';ctx.textAlign='center';ctx.fillText('NEON RUN',W/2,240);
  ctx.shadowBlur=0;ctx.font='18px sans-serif';ctx.fillStyle='#00e5ff';
  ctx.fillText('← → Spuren wechseln',W/2,305);ctx.fillText('↑ / Leertaste  Springen',W/2,333);ctx.fillText('↓  Rutschen',W/2,361);
  ctx.fillStyle='rgba(255,255,255,0.45)';ctx.font='14px sans-serif';ctx.fillText('Auch: Wischen auf Touchscreen',W/2,393);
  const pulse=.9+.1*Math.sin(Date.now()/300);ctx.save();ctx.translate(W/2,460);ctx.scale(pulse,pulse);
  ctx.shadowColor='#e040fb';ctx.shadowBlur=20;ctx.fillStyle='#e040fb';ctx.beginPath();ctx.roundRect(-90,-22,180,44,22);ctx.fill();
  ctx.shadowBlur=0;ctx.fillStyle='#fff';ctx.font='bold 20px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('STARTEN',0,0);ctx.restore();ctx.restore();
}
function drawDead(){
  const hs=Math.max(Math.floor(score),parseInt(localStorage.getItem('hs')||'0'));
  ctx.save();ctx.fillStyle='rgba(5,0,20,0.82)';ctx.fillRect(0,0,W,H);
  ctx.shadowColor='#ff4081';ctx.shadowBlur=30;ctx.fillStyle='#ff4081';ctx.font='bold 44px sans-serif';ctx.textAlign='center';ctx.fillText('ERWISCHT!',W/2,220);
  ctx.shadowBlur=0;ctx.fillStyle='#fff';ctx.font='bold 28px sans-serif';ctx.fillText('Score: '+Math.floor(score),W/2,278);
  ctx.fillStyle='#ffd700';ctx.font='bold 22px sans-serif';ctx.fillText('Coins: $'+coinCount,W/2,314);
  ctx.fillStyle='#00e5ff';ctx.font='18px sans-serif';ctx.fillText('Highscore: '+hs,W/2,350);
  const pulse=.9+.1*Math.sin(Date.now()/300);ctx.save();ctx.translate(W/2,415);ctx.scale(pulse,pulse);
  ctx.shadowColor='#e040fb';ctx.shadowBlur=20;ctx.fillStyle='#e040fb';ctx.beginPath();ctx.roundRect(-90,-22,180,44,22);ctx.fill();
  ctx.shadowBlur=0;ctx.fillStyle='#fff';ctx.font='bold 20px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('NOCHMAL',0,0);ctx.restore();ctx.restore();
}
function loop(){
  ctx.clearRect(0,0,W,H);ctx.save();
  if(shakeX||shakeY)ctx.translate(shakeX,shakeY);
  drawBg();
  if(state==='playing'&&player){
    const p=player;speed+=SI;frame++;bgOff+=speed;bgOff2+=speed;shakeX*=.8;shakeY*=.8;
    p.x=lerp(p.x,p.targetX,.25);
    if(!p.onGround){p.vy+=GV;p.y+=p.vy;p.roll+=.08;if(p.y>=GY-PH){p.y=GY-PH;p.vy=0;p.onGround=true;p.jumping=false;p.roll=0;}}
    if(p.sliding){p.slideTimer--;if(p.slideTimer<=0)p.sliding=false;}
    obTimer++;if(obTimer>=nextOb)spawnObstacle();
    obstacles=obstacles.filter(o=>o.y<H+100);obstacles.forEach(o=>o.y+=speed);
    coTimer++;if(coTimer>=nextCo)spawnCoins();
    coins=coins.filter(c=>c.y<H+50);coins.forEach(c=>c.y+=speed);
    coins.forEach(c=>{if(!c.collected&&c.lane===p.lane&&Math.abs(c.x-p.x)<PW/2+CR&&Math.abs(c.y-(p.y+PH/2))<PH/2+CR){c.collected=true;coinCount++;spawnParticles(c.x,c.y,'#ffd700');}});
    particles.forEach(pt=>{pt.x+=pt.vx;pt.y+=pt.vy;pt.vy+=.2;pt.alpha-=.035;});
    particles=particles.filter(pt=>pt.alpha>0);
    score+=speed*.05;
    for(const o of obstacles){if(checkHit(p,o)){shakeX=12;shakeY=-8;spawnParticles(p.x,p.y+PH/2,'#ff4081');state='dead';ctrlDiv.style.display='none';const hs=parseInt(localStorage.getItem('hs')||'0');if(score>hs)localStorage.setItem('hs',String(Math.floor(score)));break;}}
    particles.forEach(pt=>{ctx.save();ctx.globalAlpha=pt.alpha;ctx.fillStyle=pt.color;ctx.beginPath();ctx.arc(pt.x,pt.y,pt.r,0,Math.PI*2);ctx.fill();ctx.restore();});
    coins.forEach(c=>drawCoin(c));obstacles.forEach(o=>drawObstacle(o));drawPlayer(p);
    ctx.save();ctx.shadowColor='#00e5ff';ctx.shadowBlur=12;ctx.fillStyle='#fff';ctx.font='bold 28px sans-serif';ctx.textAlign='center';ctx.fillText(Math.floor(score),W/2,40);ctx.font='14px sans-serif';ctx.fillStyle='#00e5ff';ctx.fillText('SCORE',W/2,58);ctx.textAlign='left';ctx.fillStyle='#ffd700';ctx.font='bold 20px sans-serif';ctx.fillText('$'+coinCount,16,40);ctx.textAlign='right';ctx.fillStyle='#e040fb';ctx.font='14px sans-serif';ctx.fillText('LV '+(Math.floor((speed-IS)/.5)+1),W-16,40);ctx.restore();
  }else{if(state==='idle')drawIdle();if(state==='dead')drawDead();}
  ctx.restore();requestAnimationFrame(loop);
}
loop();
</script>
</body>
</html>
